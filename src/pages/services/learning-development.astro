---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Learning, Development & Workplace Training — BLU Consultant Services" description="Skill development, leadership training, behavioural & soft skills, workplace ethics and compliance training programs.">
  <Header />
  <main id="main-content">
    <section class="pt-28 pb-6 bg-gradient-to-br from-primary-50 via-white to-accent-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">Our Services</span>
        <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold text-gray-900">Learning, Development & Training</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">Build a skilled, engaged and high-performing workforce with tailored training programs.</p>
      </div>
    </section>

    <ServiceDetail
      title="Training Programs"
      subtitle="L&D"
      description="Our learning and development programs are designed to upskill your workforce, build leadership capabilities and create a culture of continuous growth."
      features={[
        'Skill Development Programs',
        'Leadership Training',
        'Behavioural & Soft Skills Training',
        'Workplace Ethics Training',
        'Compliance Training',
      ]}
      benefits={[
        'Increased productivity',
        'Strong leadership pipeline',
        'Improved employee engagement',
      ]}
    />
  </main>
  <Footer />
</Layout>
