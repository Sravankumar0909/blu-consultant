---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="HR Policy Drafting & Process Development — BLU Consultant Services" description="HR policy drafting, employee handbook development, SOP creation, PMS and HRMS implementation support.">
  <Header />
  <main id="main-content">
    <section class="pt-28 pb-6 bg-gradient-to-br from-primary-50 via-white to-accent-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">Our Services</span>
        <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold text-gray-900">HR Policy Drafting & Process Development</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">Build structured HR operations with comprehensive policies, SOPs and governance frameworks.</p>
      </div>
    </section>

    <ServiceDetail
      title="Policy & Process Solutions"
      subtitle="HR Governance"
      description="We help organizations establish clear, compliant and effective HR policies and processes that drive consistency, fairness and operational excellence."
      features={[
        'HR Policy Drafting',
        'Employee Handbook Development',
        'SOP Creation',
        'Performance Management System',
        'HRMS Implementation Support',
      ]}
      benefits={[
        'Structured HR operations',
        'Improved performance tracking',
        'Strong governance framework',
      ]}
    />
  </main>
  <Footer />
</Layout>
