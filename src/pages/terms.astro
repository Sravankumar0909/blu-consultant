---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const terms = [
  { title: 'Service Fees', desc: 'We charge a competitive percentage-based fee, customized based on the scope and scale of services required.' },
  { title: 'Candidate Delivery', desc: 'We provide required candidates within 5 working days after receiving the requisition.' },
  { title: 'Replacement Guarantee', desc: 'We provide a one-time replacement for 60 days from the candidate\'s joining date.' },
  { title: 'Payment Terms', desc: 'Payments must be cleared within 30 days from the candidate\'s joining date.' },
  { title: 'Custom Service Pricing', desc: 'PoSH, payroll and other service costs can be discussed on a case-to-case basis.' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Terms & Conditions — BLU Consultant Services" description="Review BLU Consultant Services terms and conditions for staffing, payroll and other HR services.">
  <Header />
  <main id="main-content">
    <!-- Page Header -->
    <section class="pt-28 pb-6 bg-gradient-to-br from-primary-50 via-white to-accent-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">Legal</span>
        <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold text-gray-900">Terms & Conditions</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">Transparent terms for a trusted partnership.</p>
      </div>
    </section>

    <section class="pt-10 pb-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-6">
          {terms.map((term, i) => (
            <div class="p-6 rounded-2xl border border-gray-100 bg-gray-50/50">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary-100 text-primary-600 font-bold text-lg flex-shrink-0">
                  {i + 1}
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-gray-900">{term.title}</h3>
                  <p class="mt-1 text-gray-600 leading-relaxed">{term.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-12 p-6 rounded-2xl bg-primary-50 border border-primary-100 text-center">
          <p class="text-gray-700">Have questions about our terms? <a href={`${base}/contact`} class="text-primary-600 font-semibold hover:underline">Contact us</a> for clarification.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>