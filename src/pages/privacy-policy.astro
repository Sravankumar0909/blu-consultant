---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    title: 'Information We Collect',
    content: [
      'Personal identification details such as name, email address, phone number and company name submitted through our contact forms.',
      'Employee data shared by clients for payroll processing, compliance management and staffing services, including salary details, PAN, Aadhaar, PF/ESI numbers and bank account information.',
      'Website usage data including IP address, browser type, pages visited and session duration collected through cookies and analytics tools.',
    ],
  },
  {
    title: 'How We Use Your Information',
    content: [
      'To deliver and manage our HR services including manpower staffing, payroll processing, PoSH compliance, training programs and insurance coverage.',
      'To communicate with you regarding service inquiries, proposals and ongoing engagements.',
      'To comply with statutory and regulatory requirements under applicable Indian labour laws, including PF, ESI, PT and LWF filings.',
      'To improve our website, services and customer experience through aggregated, anonymized analytics.',
    ],
  },
  {
    title: 'Data Protection & Security',
    content: [
      // 'All employee and client data is encrypted in transit (TLS) and at rest.',
      'Access is restricted to authorized personnel on a need-to-know basis.',
      // 'We maintain ISO 27001-aligned information security practices and conduct periodic security audits.',
      'Physical and digital access controls are enforced across all systems handling sensitive HR and payroll data.',
    ],
  },
  {
    title: 'Data Sharing & Third Parties',
    content: [
      'We do not sell, trade or rent your personal information to third parties.',
      'Data may be shared with statutory authorities (EPFO, ESIC, Income Tax Department) solely for compliance purposes as required by law.',
      // 'We may engage trusted third-party service providers (e.g., HRMS platforms, insurance partners) who are contractually bound to maintain confidentiality.',
    ],
  },
  {
    title: 'Data Retention',
    content: [
      'Client and employee data is retained for the duration of the service engagement plus any legally mandated retention period under applicable Indian laws.',
      'Contact form submissions are retained for up to 12 months unless a service engagement begins.',
      'You may request deletion of your personal data at any time by contacting us, subject to legal retention obligations.',
    ],
  },
  // {
  //   title: 'Cookies & Tracking',
  //   content: [
  //     'Our website uses essential cookies to ensure proper functionality and analytics cookies to understand visitor behaviour.',
  //     'You can disable cookies through your browser settings, though some website features may not function optimally.',
  //   ],
  // },
  // {
  //   title: 'Your Rights',
  //   content: [
  //     'You have the right to access, correct or delete your personal data held by us.',
  //     'You may withdraw consent for data processing at any time, which may affect our ability to deliver certain services.',
  //     'For any data-related requests, please contact our data protection team at the details provided on our Contact page.',
  //   ],
  // },
  {
    title: 'Changes to This Policy',
    content: [
      'We may update this privacy policy periodically to reflect changes in our practices or legal requirements.',
      'Any significant changes will be communicated through our website. Continued use of our services after changes constitutes acceptance of the updated policy.',
    ],
  },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Privacy Policy — BLU Consultant Services" description="Read BLU Consultant Services privacy policy to understand how we collect, use, protect and manage your personal and employee data.">
  <Header />
  <main id="main-content">
    <!-- Page Header -->
    <section class="pt-28 pb-6 bg-gradient-to-br from-primary-50 via-white to-accent-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">Legal</span>
        <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold text-gray-900">Privacy Policy</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">How we collect, use and protect your data.</p>
      </div>
    </section>

    <section class="pt-10 pb-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-sm text-gray-500 mb-8">Last updated: April 23, 2026</p>

        <p class="text-gray-600 leading-relaxed mb-10">
          At BLU Consultant Services, we are committed to safeguarding the privacy of our clients, their employees and our website visitors. This policy explains how we collect, use, store and protect personal information in connection with our HR consulting and outsourcing services across India.
        </p>

        <div class="space-y-6">
          {sections.map((section, i) => (
            <div class="p-6 rounded-2xl border border-gray-100 bg-gray-50/50">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary-100 text-primary-600 font-bold text-lg flex-shrink-0">
                  {i + 1}
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-gray-900">{section.title}</h3>
                  <ul class="mt-3 space-y-2">
                    {section.content.map((point) => (
                      <li class="flex items-start gap-2 text-gray-600 leading-relaxed">
                        <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-12 p-6 rounded-2xl bg-primary-50 border border-primary-100 text-center">
          <p class="text-gray-700">Have questions about your data? <a href={`${base}/contact`} class="text-primary-600 font-semibold hover:underline focus:underline focus:outline-none">Contact our team</a> for assistance.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
