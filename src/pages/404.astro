---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page Not Found - BLU Consultant Services" description="The page you are looking for doesn't exist or has been moved.">
    <Header />
    <main id="main-content">
        <section class="pt-28 pb-20 min-h-[70vh] flex items-center bg-gradient-to--br from-primary-50 via-white to-accent-50">
            <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <p class="text-8xl font-extrabold text-primary-600">404</p>
                <h1 class="mt-4 text-3xl sm:text-4xl font-bold text-gray-900">Page Not Found</h1>
                <p class="mt-4 text-lg text-gray-600">Sorry, the page you are looking for doesn't exist or has been moved.</p>
                <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a 
                        href="/"
                        class="px-8 py-3 rounded-lg bg-primary-600 text-white font-semibold hover:bg-primary-700 focus:ring-primary-400 focus:ring-offset-2 transition-colors"
                    >
                        Back to Home
                    </a>
                    <a 
                        href="/contact"
                        class="px-8 py-3 rounded-lg border-2 border-gray-200 text-gray-700 font-semibold hover:border-primary-300 hover:text-primary-600 focus:ring-2 focus:ring-primary-400 focus:ring-offset-2 transition-colors"
                    >
                        Contact Us
                    </a>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>"