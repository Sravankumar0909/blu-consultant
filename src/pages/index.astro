---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="BLU Consultant Services - Your One-Stop HR Consultant Services">
	<Header />
	<main id="main-content">
		<Hero />
		<Services preview={true} />
		<Testimonials />

		<!-- CTA Section -->
		<section class="py-20 bg-gradient-to-r from-primary-600 to-primary-800">
			<div class="max-w-4xl mx-auto px-4 text-center">
				<h2 class="text-3xl sm:text-4xl font-bold text-white">Ready to Transform Your HR Operations?</h2>
				<p class="mt-4 text-primary-100 text-lg">Let us be your trusted HR partner. Get a customized proposal within 24 hours.</p>
				<div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
					<a href="/contact" class="px-8 py-3.5 rounded-lg bg-white text-primary-700 font-semibold text-lg hover:bg-gray-100 transition-colors">
						Get Started Today
					</a>
					<a href="/services" class="px-8 py-3.5 rounded-lg border-2 border-white/30 text-white font-semibold text-lg hover:bg-white/10 transition-colors">
						View All Services
					</a>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
