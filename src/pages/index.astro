---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="BLU Consultant Services - Your One-Stop HR Consultant Services">
	<Header />
	<main id="main-content">
		<Hero />
		<Services preview={true} />
		<Testimonials />

		<!-- CTA Section -->
		<section class="py-20 bg-gradient-to-r from-primary-600 to-primary-800">
			<div class="max-w-4xl mx-auto px-4 text-center">
				<h2 class="text-3xl sm:text-4xl font-bold text-white">Ready to Transform Your HR Operations?</h2>
				<p class="mt-4 text-primary-100 text-lg">Let us be your trusted HR partner. Get a customized proposal within 24 hours.</p>
				<div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
					<a href="/contact" class="px-8 py-3.5 rounded-lg bg-white text-primary-700 font-semibold text-lg hover:bg-gray-100 transition-colors">
						Get Started Today
					</a>
					<a href="/services" class="px-8 py-3.5 rounded-lg border-2 border-white/30 text-white font-semibold text-lg hover:bg-white/10 transition-colors">
						View All Services
					</a>
				</div>
			</div>
		</section>

		<!-- Job Seekers CTA -->
		 <section class="py-20 bg-gray-50">
			<div class="max-w-4xl mx-auto px-4 text-center">
				<span class="text-sm font-semibold tracking-wider uppercase text-accent-600">For Job Seekers</span>
				<h2 class="mt-3 text-3xl sm:text-4xl font-bold text-gray-900">Looking for a Job or Career Switch?</h2>
				<p class="mt-4 text-gray-600 text-lg">Submit your profile and we'll match you to recruitment drives that fit your skills. Get notified when the right opportunity comes along.</p>
				<div class="mt-8">
					<a href="/careers" class="inline-flex items-center px-8 py-3.5 rounded-lg bg-primary-600 text-white font-semibold text-lg hover:bg-primary-700 transition-colors shadow-md shadow-primary-200">
						Register as a Job Seeker
						<svg class="w-5 h-5 ml-2" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
						</svg>
					</a>
				</div>
			</div>
		 </section>
	</main>
	<Footer />
</Layout>
