---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const industries = [
  { name: 'IT (Software & Hardware)', icon: '💻', desc: 'End-to-end talent acquisition, IT compliance, and scalable HR solutions tailored for software and hardware organizations.' },
  { name: 'Logistics', icon: '🚚', desc: 'Comprehensive workforce management, labor law compliance, and staffing solutions designed for logistics and supply chain operations.' },
  { name: 'E-Commerce', icon: '🛒', desc: 'Agile scaling solutions, seasonal workforce support, and end-to-end employee lifecycle management for e-commerce businesses.' },
  { name: 'BFSI (Banking, Financial Services & Insurance)', icon: '🏦', desc: 'Regulatory compliance, background verification, and specialized hiring solutions for banking, financial services, and insurance sectors.' },
  { name: 'Pharmacy', icon: '💊', desc: 'Compliance-focused HR solutions, statutory services and specialized recruitment for pharmaceutical companies.' },
  { name: 'FMCG / FMCD', icon: '🛍️', desc: 'High-volume hiring, field force management, and training programs tailored for fast-moving consumer goods and non-consumer durable companies.' },
  { name: 'Healthcare / NGO', icon: '🏥', desc: 'Credentialing support, compliance management, and mission-aligned recruitment for healthcare institutions and nonprofit organizations.' },
  { name: 'Manufacturing', icon: '🏭', desc: 'Labor law compliance, workforce planning, and safety training programs designed to support efficient manufacturing operations.' },
  { name: 'Event Management', icon: '🎪', desc: 'Flexible staffing solutions, contract workforce management, and on-demand talent for events, exhibitions, and hospitality services.' },
  { name: 'Customer Care / BPO', icon: '🎧', desc: 'Bulk hiring, attrition management, training programs and payroll services for BPO and customer support centers.' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Industries We Serve — BLU Consultant Services" description="BLU Consultant Services serves 10+ industries including IT, BFSI, Healthcare, Manufacturing, E-Commerce, Logistics and more across India.">
  <Header />
  <main id="main-content">
    <!-- Page Header -->
    <section class="pt-28 pb-6 bg-gradient-to-br from-primary-50 via-white to-accent-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">Industries</span>
        <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold text-gray-900">Industries We Serve</h1>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">We provide domain-specific HR expertise tailored to meet the unique challenges and requirements of your industry. Our solutions are designed to align with your business goals, ensuring effective workforce management, compliance, and sustainable growth across diverse sectors.</p>
      </div>
    </section>

    <section class="pt-10 pb-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {industries.map((ind) => (
            <div class="group p-6 rounded-2xl border border-gray-100 bg-gray-50/50 hover:bg-white hover:shadow-xl hover:shadow-gray-100/50 hover:border-primary-100 transition-all duration-300">
              <div class="text-4xl mb-4">{ind.icon}</div>
              <h3 class="text-lg font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">{ind.name}</h3>
              <p class="mt-2 text-gray-600 text-sm leading-relaxed">{ind.desc}</p>
            </div>
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-16 text-center">
          <div class="inline-block p-8 rounded-2xl bg-gradient-to-r from-primary-50 to-accent-50 border border-primary-100">
            <h3 class="text-xl font-bold text-gray-900">Don't see your industry?</h3>
            <p class="mt-2 text-gray-600">Our solutions are adaptable. Contact us to discuss your specific needs.</p>
            <a href={`${base}/contact`} class="inline-block mt-4 px-6 py-2.5 rounded-lg bg-primary-600 text-white font-semibold hover:bg-primary-700 transition-colors">
              Talk to Us
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
