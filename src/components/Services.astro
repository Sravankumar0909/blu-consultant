---
interface Props {
  preview?: boolean;
}

const { preview = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const services = [
  {
    icon: `<svg class="w-7 h-7" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
    title: 'Manpower Outsourcing & Staffing',
    description: 'Permanent & contract staffing, leadership hiring, PAN India recruitment support and background verification.',
    href: `${base}/services/manpower-outsourcing`,
    color: 'primary',
  },
  {
    icon: `<svg class="w-7 h-7" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title: 'PoSH Advisory & Compliance',
    description: 'External member services, PoSH policy drafting, IC training, employee awareness and annual filing support.',
    href: `${base}/services/posh-advisory`,
    color: 'accent',
  },
  {
    icon: `<svg class="w-7 h-7" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>`,
    title: 'HR Compliance & Statutory Services',
    description: 'PF, ESI, PT, LWF compliance, labour law advisory, shop & establishment registration and compliance audits.',
    href: `${base}/services/hr-compliance`,
    color: 'primary',
  },
  {
    icon: `<svg class="w-7 h-7" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>`,
    title: 'HR Policy Drafting & Process Development',
    description: 'HR policy drafting, employee handbook development, SOP creation, PMS and HRMS implementation support.',
    href: `${base}/services/hr-policy`,
    color: 'accent',
  },
  {
    icon: `<svg class="w-7 h-7" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Payroll & Employee Lifecycle Management',
    description: 'End-to-end payroll processing, attendance & leave management, salary structuring and full & final settlement.',
    href: `${base}/services/payroll-management`,
    color: 'primary',
  },
  {
    icon: `<svg class="w-7 h-7" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.26 367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.41415-5A2 2 0 009 10.172V5L8 4z"/></svg>`,
    title: 'Learning, Development & Training',
    description: 'Skill development, leadership training, behavioural & soft skills, workplace ethics and compliance training.',
    href: `${base}/services/learning-development`,
    color: 'accent',
  },
  {
    icon: `<svg class="w-7 h-7" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
    title: 'Insurance Coverage Solutions',
    description: 'Group medical & personal accident coverage, business risk, marine, property & fire insurance with advisory support.',
    href: `${base}/services/insurance-coverage`,
    color: 'primary',
  },
];

const displayedServices = preview ? services.slice(0, 3) : services;
---

<section class="pt-10 pb-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto">
      <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">What We Offer</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-gray-900">Our Comprehensive Services</h2>
      <p class="mt-4 text-gray-600 text-lg">We specialize in comprehensive services that build compliant, inclusive and high-performing workforce — all under one roof.</p>
    </div>

    <div class="mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {displayedServices.map((service) => (
        <a href={service.href} class="group block p-8 rounded-2xl border border-gray-100 bg-gray-50/50 hover:bg-white hover:shadow-xl hover:shadow-gray-100/50 hover:border-primary-100 transition-all duration-300">
          <div class="w-14 h-14 flex items-center justify-center rounded-xl bg-primary-100 text-primary-600 group-hover:bg-primary-600 group-hover:text-white transition-colors duration-300">
            <Fragment set:html={service.icon} />
          </div>
          <h3 class="mt-5 text-xl font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">{service.title}</h3>
          <p class="mt-3 text-gray-600 leading-relaxed">{service.description}</p>
          <span class="inline-flex items-center mt-4 text-sm font-semibold text-primary-600 group-hover:gap-2 transition-all">
            Learn more
            <svg class="w-4 h-4 ml-1" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      ))}
    </div>

    {preview && (
      <div class="mt-12 text-center">
        <p class="text-gray-500 text-sm mb-4">Showing 3 of 7 services</p>
        <a
          href={`${base}/services`}
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-lg bg-primary-600 text-white font-semibold hover:bg-primary-700 transition-colors shadow-md shadow-primary-200"
        >
          View All Services
          <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>