---
import { Image } from "astro:assets";
import bluLogo from '../assets/BLU_Consultant_Services_Logo.png';

 const socialLinks = [
    { label: 'LinkedIn', href: 'https://www.linkedin.com', icon: `<svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.85 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>` },
    { label: 'Twitter', href: 'https://www.twitter.com', icon: `<svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.742l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>` },
    { label: 'Facebook', href: 'https://www.facebook.com', icon: `<svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>` },
 ];

const footerLinks = [
  {
    title: 'Services',
    links: [
      { label: 'Manpower Outsourcing', href: '/services/manpower-outsourcing' },
      { label: 'PoSH Advisory', href: '/services/posh-advisory' },
      { label: 'HR Compliance', href: '/services/hr-compliance' },
      { label: 'Payroll Management', href: '/services/payroll-management' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: '/about' },
      { label: 'Industries', href: '/industries' },
      { label: 'All Services', href: '/services' },
      { label: 'Careers', href: '/careers' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    title: 'Support',
    links: [
      { label: 'Terms & Conditions', href: '/terms' },
      { label: 'Privacy Policy', href: '/privacy-policy' },
      { label: 'FAQ', href: '/about#faq' },
    ],
  },
];
---

<footer class="bg-gray-900 text-gray-300" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" aria-label="BLU Consultant Services Home" class="flex items-center gap-2 font-bold text-xl text-white">
          <Image src={bluLogo} alt="BLU Consultant Services" width={320} height={128} class="w-auto h-14 sm:h-16" style="filter: brightness(0) invert(1);"/>
        </a>
        <p class="mt-4 text-sm leading-relaxed max-w-xs">
          Your trusted partner in building better workplaces. Comprehensive HR solutions for businesses of every size.
        </p>
        <div class="mt-6 flex gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              aria-label={social.label}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-lg bg-gray-800 text-gray-400 hover:bg-primary-600 hover:text-white transition-colors"
            >
              <Fragment set:html={social.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Links -->
      {footerLinks.map((group) => (
        <nav aria-label={`${group.title} links`}>
          <h4 class="text-sm font-semibold text-white uppercase tracking-wider">{group.title}</h4>
          <ul class="mt-4 space-y-3">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm hover:text-white focus:text-white focus:outline-none focus:underline transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-gray-500">&copy; 2026 BLU Consultant Services. All rights reserved.</p>
      <p class="text-sm text-gray-500">Made with care for people-first businesses.</p>
    </div>
  </div>
</footer>