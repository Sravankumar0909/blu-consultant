---
import { Image } from "astro:assets";
import bluLogo from '../assets/BLU_Consultant_Services_Logo.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

 const socialLinks = [
    { label: 'LinkedIn', href: 'https://www.linkedin.com/in/blu-consultant-services-453a4839b', icon: `<svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.85 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>` },
    { label: 'Instagram', href: 'https://www.instagram.com/blu_consultantservices?igsh=MWI2ZW9vNmZmeHZtdA==', icon: `<svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.225-.148-4.771-1.664-4.919-4.919-.058-1.265-.07-1.645-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>` },
 ];

const footerLinks = [
  {
    title: 'Services',
    links: [
      { label: 'Manpower Outsourcing', href: `${base}/services/manpower-outsourcing` },
      { label: 'PoSH Advisory', href: `${base}/services/posh-advisory` },
      { label: 'HR Compliance', href: `${base}/services/hr-compliance` },
      { label: 'Payroll Management', href: `${base}/services/payroll-management` },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: `${base}/about` },
      { label: 'Industries', href: `${base}/industries` },
      { label: 'All Services', href: `${base}/services` },
      { label: 'Careers', href: `${base}/careers` },
      { label: 'Contact', href: `${base}/contact` },
    ],
  },
  {
    title: 'Support',
    links: [
      { label: 'Terms & Conditions', href: `${base}/terms` },
      { label: 'Privacy Policy', href: `${base}/privacy-policy` },
      { label: 'FAQ', href: `${base}/about#faq` },
    ],
  },
];
---

<footer class="bg-gray-900 text-gray-300" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href={base || '/'} aria-label="BLU Consultant Services Home" class="flex items-center gap-2 font-bold text-xl text-white">
          <Image src={bluLogo} alt="BLU Consultant Services" width={320} height={128} class="w-auto h-14 sm:h-16" style="filter: brightness(0) invert(1);"/>
        </a>
        <p class="mt-4 text-sm leading-relaxed max-w-xs">
          Your trusted partner in building better workplaces. Comprehensive HR solutions for businesses of every size.
        </p>
        <div class="mt-6 flex gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              aria-label={social.label}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-lg bg-gray-800 text-gray-400 hover:bg-primary-600 hover:text-white transition-colors"
            >
              <Fragment set:html={social.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Links -->
      {footerLinks.map((group) => (
        <nav aria-label={`${group.title} links`}>
          <h4 class="text-sm font-semibold text-white uppercase tracking-wider">{group.title}</h4>
          <ul class="mt-4 space-y-3">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm hover:text-white focus:text-white focus:outline-none focus:underline transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-gray-500">&copy; 2026 BLU Consultant Services. All rights reserved.</p>
      <p class="text-sm text-gray-500">Made with care for people-first businesses.</p>
    </div>
  </div>
</footer>