---
const team = [
    { name: 'Sarah Mitchell', role: 'Founder & Chief HR Strategist', bio: '20+ years transforming HR departments across fortune 500 companies and startups alike.' },
    { name: 'James Carter', role: 'Head of Talent Acquisition', bio: 'Recruited 10,000+ professionals with a 95% placement success rate in competitive markets.'},
    { name: 'Priya Sharma', role: 'Compliance & Legal Lead', bio: 'Former labor law attorney ensuring clients stay 100% compliant across all jursidictions' },
    { name: 'David Okonkwo', role: 'Training & Development Director', bio: 'Designed award-winning L&D programs adopted by organizations in 12 countries'},
];

const whyChoose = [
    { title: 'One-Stop HR Solutions', desc: 'All your HR needs managed under one roof - staffing, compliance, payroll, training & more.' },
    { title: 'Industry Experienced Professionals', desc: 'Our team brings decades of domain expertise across 10+ industries.'},
    { title: 'Customized Client-Centric Approach', desc: 'Tailored solutions designed around your unique culture and requirements.' },
    { title: 'PAN India Service Support', desc: 'Seamless HR support across all states and union territories.' },
    { title: 'Cost-Effective & Scalable Solutions', desc: 'Flexible engagement models that grow with your business.' },
];
---

<section class="pt-6 pb-10 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Vision & Mission -->
        <div class="text-center mb-8">
            <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">Our Guiding Priniciples</span>
            <h2 class="mt-2 text-3xl sm:text-4xl font-bold text-gray-900">Driven by Purpose</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6 mb-12">
            <!-- Vision Card -->
            <div class="relative p-8 rounded-2xl bg-gradient-to-br from-primary-600 to-primary-800 text-white overflow-hidden">
                <div class="absolute top-0 right-0 w-40 h-40 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
                <div class="relative">
                    <div class="w-14 h-14 flex items-center justify-center rounded-xl bg-white/20 mb-5">
                        <svg class="w-7 h-7" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4">Our Vision</h3>
                    <p class="text-white/90 leading-relaxed text-lg">
                        To become the premier leader in integrated HR solutions, fostering exceptional leadership, uniting top talent, and empowering businesses to thrive through seamless, compliant, and cost-effective human resource management.
                    </p>
                </div>
            </div>

            <!-- Mission Card -->
             <div class="relative p-8 rounded-2xl bg-gradient-to-br from-accent-600 to-accent-800 text-white overflow-hidden">
                <div class="absolute top-0 right-0 w-40 h-40 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
                <div class="relative">
                    <div class="w-14 h-14 flex items-center justify-center rounded-xl bg-white/20 mb-5">
                        <svg class="w-7 h-7" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4">Our Mission</h3>
                    <p class="text-white/90 leading-relaxed text-lg">
                        To deliver Strategic HR Solutions that foster compliance, inclusivity and performance excellence, helping organization's build empowered and engaged workforces.
                    </p>
                </div>
            </div>
        </div>

        <!-- About -->
        <div class="grid lg:grid-cols-1 gap-10 items-center mt-12">
            <div>
                <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">About BLU Consultant Services</span>
                <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-gray-900">
                    Building Better Workplaces
                    <!-- <br />Since 2011 -->
                </h2>
                <p class="mt-4 text-gray-600 text-sm leading-relaxed">
                    BLU Consultant Services is your trusted and single partner for all HR solutions. We move beyond transactional tasks to provide strategic support that builds a compliant, inclusive and high-performing workforce.
                </p>
                <p class="mt-4 text-gray-600 text-sm leading-relaxed">
                    Our team of certified HR professionals brings together decades of experience in recruitment, employment law, organizational development, and employee engagement. We don’t just consult — we become an extension of your team.
                </p>
                <!-- <div class="mt-8 flex flex-wrap gap-6">
                {[
                    { label: "SHRM Certified", icon: "✓" },
                    { label: "ISO 27001 Compliant", icon: "✓" },
                    { label: "GDPR Ready", icon: "✓" },
                ].map((badge) => (
                    <div class="flex items-center gap-2 text-sm font-medium text-gray-700">
                    <span class="w-6 h-6 flex items-center justify-center rounded-full bg-accent-100 text-accent-700 text-xs font-bold">
                        {badge.icon}
                    </span>
                    {badge.label}
                    </div>
                ))}
                </div> -->
            </div>
            <!-- <div class="relative">
                <div class="aspect-square rounded-2xl bg-gradient-to-br from-primary-100 to-accent-100 flex items-center justify-center">
                <div class="text-center p-8">
                    <div class="text-6xl font-bold text-primary-600">15+</div>
                    <div class="mt-2 text-xl text-gray-600">Years of Excellence</div>
                    <div class="mt-6 text-4xl font-bold text-accent-600">500+</div>
                    <div class="mt-2 text-xl text-gray-600">Happy Clients</div>
                </div>
                </div>
            </div> -->
        </div>

        <!-- Why Choose Us -->
        <div class="mt-14">
            <div class="text-center mb-8">
                <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">Why Choose Us</span>
                <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-gray-900">The BLU Consultant Services Advantage</h2>
            </div>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {whyChoose.map((item, i) => (
                    <div class="p-6 rounded-2xl border border-gray-100 bg-white hover:shadow-lg hover:shadow-primary-50 hover:border-primary-100 transition-all duration-300">
                        <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary-100 text-primary-600 font-bold text-lg mb-4">
                            {i + 1}
                        </div>
                        <h3 class="text-lg font-semibold text-gray-900">{item.title}</h3>
                        <p class="mt-2 text-gray-600 text-sm leading-relaxed">{item.desc}</p>
                    </div>
                ))}
            </div>
        </div>

        <!-- Team -->
        <!-- <div class="mt-14">
            <div class="text-center">
                <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">Our Team</span>
                <h2 class="mt-2 text-3xl sm:text-4xl font-bold text-gray-900">Meet the Experts</h2>
            </div>
            <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
                {team.map((member) => (
                    <div class="text-center group">
                        <div class="w-28 h-28 mx-auto rounded-full bg-gradient-to-br from-primary-200 to-accent-200 flex items-center justify-center text-3xl font-bold text-primary-700 group-hover:scale-105 transition-transform">
                            {member.name.split(" ").map((n) => n[0]).join("")}
                        </div>
                        <h3 class="mt-5 text-lg font-semibold text-gray-900">{member.name}</h3>
                        <p class="text-sm font-medium text-primary-600">{member.role}</p>
                        <p class="mt-2 text-sm text-gray-500">{member.bio}</p>
                    </div>
                ))}
            </div>
        </div> -->
    </div>
</section>
