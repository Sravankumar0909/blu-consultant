---
---

<section id="contact" class="pt-10 pb-20 bg-white" aria-labelledby="contact-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16">
      <!-- Info -->
      <div>
        <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">Contact Us</span>
        <h2 id="contact-heading" class="mt-3 text-3xl sm:text-4xl font-bold text-gray-900">Let's Start the Conversation</h2>
        <p class="mt-4 text-gray-600 text-lg leading-relaxed">
          Ready to transform your HR operations? Fill out the form and our team will get back to you within 24 hours with a customized proposal.
        </p>

        <div class="mt-10 space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-primary-100 text-primary-600 flex-shrink-0">
              <svg class="w-6 h-6" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Email</p>
              <p class="text-gray-600">hr@bluconsultantservices.com</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-primary-100 text-primary-600 flex-shrink-0">
              <svg class="w-6 h-6" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.4931.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Phone</p>
              <p class="text-gray-600">+91 7204123457</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-primary-100 text-primary-600 flex-shrink-0">
              <svg class="w-6 h-6" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.878 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Office</p>
              <p class="text-gray-600">JP Nagar, Bangalore<br />Madhapur, Hyderabad</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
        <form class="space-y-5" id="contact-form" action="#" method="POST" aria-label="Contact form" novalidate>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1">First Name <span class="text-red-500" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                autocomplete="given-name"
                required
                aria-required="true"
                aria-describedby="firstName-error"
                class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"
                placeholder="John"
              />
              <p id="firstName-error" class="mt-1 text-xs text-red-500 hidden" role="alert">
                First name is required.
              </p>
            </div>
            <div>
              <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
              <input
                type="text"
                id="lastName"
                name="lastName"
                autocomplete="family-name"
                aria-required="true"
                class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"
                placeholder="Doe"
              />
            </div>
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Work Email <span class="text-red-500" aria-hidden="true">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              required
              aria-required="true"
              aria-describedby="email-error"
              class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"
              placeholder="john@company.com"
            />
            <p id="email-error" class="mt-1 text-xs text-red-500 hidden" role="alert">
              Please enter a valid work email address.
            </p>
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number <span class="text-red-500" aria-hidden="true">*</span></label>
            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              required
              aria-required="true"
              aria-describedby="phone-error"
              class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"
              placeholder="+91 98765 43210"
            />
            <p id="phone-error" class="mt-1 text-xs text-red-500 hidden" role="alert">
              Please enter a valid phone number.
            </p>
          </div>
          <div>
            <label for="company" class="block text-sm font-medium text-gray-700 mb-1">Company Name <span class="text-red-500" aria-hidden="true">*</span></label>
            <input
              type="text"
              id="company"
              name="company"
              autocomplete="organization"
              required
              aria-required="true"
              aria-describedby="company-error"
              class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"
              placeholder="Acme Inc."
            />
            <p id="company-error" class="mt-1 text-xs text-red-500 hidden" role="alert">
              Company name is required.
            </p>
          </div>
          <div>
            <label for="employees" class="block text-sm font-medium text-gray-700 mb-1">Number of Employees</label>
            <select
              id="employees"
              name="employees"
              class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition bg-white"
            >
              <option value="">Select range</option>
              <option value="1-25">1 - 25</option>
              <option value="26-100">26 - 100</option>
              <option value="101-500">101 - 500</option>
              <option value="500+">500+</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-1">How can we help?</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition resize-none"
              placeholder="Tell us about your HR needs..."
            ></textarea>
          </div>
          <button
            type="submit"
            id="submit-btn"
            disabled
            class="w-full px-6 py-3 rounded-lg bg-primary-600 text-white font-semibold hover:bg-primary-700 focus:ring-2 focus:ring-primary-400 focus:ring-offset-2 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Send Message
          </button>
          <p class="text-xs text-gray-500 text-center" aria-live="polite">We'll respond within 24 hours. No spam, ever.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // @ts-nocheck

  document.addEventListener('astro:page-load', () => {
      // This ensures the script runs after Astro has hydrated the page and all elements are available in the DOM.

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const PHONE_RE = /^[+]?[\d\s\-().]{7,15}$/;
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyIj60-MpoStSC5FGK-3pRl6bHpEv0jwhmbnCQ2r-JtXqNMVXj5kMQE72walI9hnmH4/exec";

    // ── Element references ───────────────────────────────────────────────────

    const form = /** @type {HTMLFormElement | null} */ (document.getElementById("contact-form"));
    const firstNameEl = /** @type {HTMLInputElement | null} */ (document.getElementById("firstName"));
    const emailEl = /** @type {HTMLInputElement | null} */ (document.getElementById("email"));
    const phoneEl = /** @type {HTMLInputElement | null} */ (document.getElementById("phone"));
    const companyEl = /** @type {HTMLInputElement | null} */ (document.getElementById("company"));
    const submitBtn = /** @type {HTMLButtonElement | null} */ (document.getElementById("submit-btn"));

    // ── Helpers ──────────────────────────────────────────────────────────────

    /**
     * @param {HTMLInputElement} inputEl
     * @param {string} errorId
     * @param {string} message
     */
    function setError(inputEl, errorId, message) {
      const err = document.getElementById(errorId);
      inputEl.classList.add("border-red-400");
      inputEl.classList.remove("border-green-400", "border-gray-200");
      if (err) {
        err.textContent = message;
        err.classList.remove("hidden");
      }
    }

    /**
     * @param {HTMLInputElement} inputEl
     * @param {string} errorId
     */
    function clearError(inputEl, errorId) {
      const err = document.getElementById(errorId);
      inputEl.classList.remove("border-red-400");
      inputEl.classList.add("border-green-400");
      if (err) {
        err.classList.add("hidden");
      }
    }

    // ── Submit button state ──────────────────────────────────────────────────

    function updateSubmitState() {
      if (!submitBtn) return;
      const firstName = firstNameEl?.value.trim() ?? "";
      const email = emailEl?.value.trim() ?? "";
      const phone = phoneEl?.value.trim() ?? ""; 
      const company = companyEl?.value.trim() ?? "";

      const allFilled = firstName !== "" && EMAIL_RE.test(email) && PHONE_RE.test(phone) && company !== "";
      submitBtn.disabled = !allFilled;
    }

    // ── Per-field validators ─────────────────────────────────────────────────

    function validateFirstName() {
      if (!firstNameEl) return false;
      if (!firstNameEl.value.trim()) {
        setError(firstNameEl, "firstName-error", "First name is required.");
        return false;
      }
      clearError(firstNameEl, "firstName-error");
      return true;
    }

    function validateEmail() {
      if (!emailEl) return false;
      const val = emailEl.value.trim();
      if (!val) {
        setError(emailEl, "email-error", "Work email is required.");
        return false;
      }
      if (!EMAIL_RE.test(val)) {
        setError(emailEl, "email-error", "Please enter a valid work email address.");
        return false;
      }
      clearError(emailEl, "email-error");
      return true;
    }

    function validatePhone() {
      if (!phoneEl) return false;
      const val = phoneEl.value.trim();
      if (!val) {
        setError(phoneEl, "phone-error", "Phone number is required.");
        return false;
      }
      if (!PHONE_RE.test(val)) {
        setError(phoneEl, "phone-error", "Please enter a valid phone number.");
        return false;
      }
      clearError(phoneEl, "phone-error");
      return true;
    }

    function validateCompany() {
      if (!companyEl) return false;
      if (!companyEl.value.trim()) {
        setError(companyEl, "company-error", "Company name is required.");
        return false;
      }
      clearError(companyEl, "company-error");
      return true;
    }

    // ── Blur + input listeners ───────────────────────────────────────────────

    firstNameEl?.addEventListener("blur", validateFirstName);
    firstNameEl?.addEventListener("input", () => {
      validateFirstName();
      updateSubmitState();
    });

    emailEl?.addEventListener("blur", validateEmail);
    emailEl?.addEventListener("input", () => {
      validateEmail();
      updateSubmitState();
    });

    phoneEl?.addEventListener("blur", validatePhone);
    phoneEl?.addEventListener("input", () => {
      validatePhone();
      updateSubmitState();
    });

    companyEl?.addEventListener("blur", validateCompany);
    companyEl?.addEventListener("input", () => {
      validateCompany();
      updateSubmitState();
    });

    // ── Submit ───────────────────────────────────────────────────────────────

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const ok = [validateFirstName(), validateEmail(), validatePhone(), validateCompany()].every(Boolean);
      if (!ok) {
        const firstError = /** @type {HTMLElement | null} */ (document.querySelector(".border-red-400"));
        firstError?.focus();
        return;
      }

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      if (submitBtn) {
        submitBtn.textContent = "Sending...";
        submitBtn.disabled = true;
      }

      try {
        const res = await fetch(SCRIPT_URL, {
          method: "POST",
          headers: { "Content-Type": "text/plain" },
          body: JSON.stringify({
            ...data,
            origin: window.location.origin,
          }),
        });

        const result = await res.json();

        if (result.error) {
          throw new Error(result.error);
        }

        form.reset();
        [firstNameEl, emailEl, phoneEl, companyEl].forEach((el) => {
          el?.classList.remove("border-green-400", "border-red-400");
          el?.classList.add("border-gray-200");
        });

        if (submitBtn) submitBtn.textContent = "Message Sent!";

        setTimeout(() => {
          if (submitBtn) {
            submitBtn.textContent = "Send Message";
            submitBtn.disabled = true;
          }
        }, 3000);

      } catch (err) {
        if (submitBtn) {
          submitBtn.textContent = "Error - Try Again";
          submitBtn.disabled = false;
        }
      }
    });

    // ── Init ─────────────────────────────────────────────────────────────────

    updateSubmitState();
  });
</script>
