---
const faqs = [
  {
    question: "What industries do you serve?",
    answer: "We work with businesses across all industries including technology, healthcare, manufacturing, retail, finance, and professional services. Our solutions are tailored to meet the unique requirements of each sector.",
  },
  {
    question: "How quickly can you onboard our company?",
    answer: "Most clients are fully onboarded within 2–4 weeks. This includes a thorough assessment of your current HR practices, system setup, and team training. For urgent needs, we offer an expedited onboarding track.",
  },
  {
    question: "Do you replace our internal HR team?",
    answer: "Not at all. We complement and support your existing HR team by handling specialized or time-consuming tasks. For companies without an HR team, we can serve as your complete outsourced HR department.",
  },
  {
    question: "What makes BLU Consultant Services different from other consultants?",
    answer: "We combine deep expertise with a hands-on approach. Unlike traditional consultants who deliver reports and leave, we stay engaged as an ongoing partner. Plus our transparent pricing means no surprise fees.",
  },
  // {
  //   question: "Is our employee data secure?",
  //   answer: "Yes — security is our top priority. We are ISO 27001 certified and GDPR compliant. All data is encrypted at rest and in transit, and we undergo annual third-party security audits.",
  // },
];
---

<section id="faq" class="pt-10 pb-20 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">FAQ</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-gray-900">Frequently Asked Questions</h2>
      <p class="mt-4 text-gray-600 text-lg">Everything you need to know about working with BLU Consultant Services.</p>
    </div>

    <div class="mt-12 divide-y divide-gray-200">
      {faqs.map((faq, i) => (
        <div class="faq-item py-6">
          <button
            class="faq-toggle w-full flex items-center justify-between text-left gap-4"
            aria-expanded="false"
            data-faq={i}
          >
            <span class="text-lg font-semibold text-gray-900">{faq.question}</span>
            <svg class="faq-icon w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="faq-answer hidden mt-3 text-gray-600 leading-relaxed pr-12">
            {faq.answer}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const answer = item?.querySelector('.faq-answer');
      const icon = btn.querySelector('.faq-icon');
      const isOpen = !answer?.classList.contains('hidden');

      // Close all
      document.querySelectorAll('.faq-answer').forEach((a) => a.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach((i) => i.classList.remove('rotate-180'));
      document.querySelectorAll('.faq-toggle').forEach((b) => b.setAttribute('aria-expanded', 'false'));

      // Toggle current
      if (!isOpen) {
        answer?.classList.remove('hidden');
        icon?.classList.add('rotate-180');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
