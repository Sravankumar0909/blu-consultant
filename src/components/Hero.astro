---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="relative pt-28 pb-10 md:pt-36 md:pb-10 bg-gradient-to-br from-primary-50 via-white to-accent-50 overflow-hidden">
  <!-- Decorative blobs -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-primary-200/30 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
  <div class="absolute bottom-0 left-0 w-72 h-72 bg-accent-200/30 rounded-full blur-3xl translate-y-1/3 -translate-x-1/4"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="inline-block px-4 py-1.5 mb-6 text-xs font-semibold tracking-wider uppercase rounded-full bg-primary-100 text-primary-700">
      Your One-Stop HR Partner
    </span>

    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 leading-tight lg:leading-tight max-w-4xl mx-auto">
      Empowering Your <span class="text-primary-600">Workforce</span>,<br />
      Simplifying Your <span class="text-accent-600">HR</span>
      <span>Operations And Compliance</span>
    </h1>

    <p class="mt-6 text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
      Your trusted partner for all HR solutions. We move beyond transactional tasks to provide strategic support that builds a compliant,
      inclusive and high-performing workforce.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={`${base}/contact`}
        class="w-full sm:w-auto px-8 py-3.5 rounded-lg bg-primary-600 text-white font-semibold text-lg hover:bg-primary-700
        transition-colors shadow-lg shadow-primary-200"
      >
        Book a Free Consultation
      </a>
      <a
        href={`${base}/services`}
        class="w-full sm:w-auto px-8 py-3.5 rounded-lg border-2 border-gray-200 text-gray-700 font-semibold text-lg
        hover:border-primary-300 hover:text-primary-600 transition-colors"
      >
        Explore Services
      </a>
    </div>

    <!-- Stats -->
    <!-- <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto">
      {[
        { value: '500+', label: 'Clients Served' },
        { value: '98%', label: 'Retention Rate' },
        { value: '15+', label: 'Years Experience' },
        { value: 'PAN India', label: 'Service Coverage' },
      ].map((stat) => (
        <div class="text-center">
          <p class="text-3xl font-bold text-primary-700">{stat.value}</p>
          <p class="mt-1 text-sm text-gray-500">{stat.label}</p>
        </div>
      ))}
    </div> -->
  </div>
</section>