---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  features: string[];
  benefits: string[];
  process?: { title: string; desc: string }[];
}

const { title, subtitle, description, features, benefits, process } = Astro.props;
---

<section class="pt-10 pb-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-start">

      <!-- Left: Features -->
      <div>
        <span class="text-sm font-semibold tracking-wider uppercase text-primary-600">{subtitle}</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-gray-900">{title}</h2>
        <p class="mt-4 text-gray-600 text-lg leading-relaxed">{description}</p>

        <div class="mt-10 space-y-4">
          {features.map((feature) => (
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 flex items-center justify-center rounded-full bg-primary-100 text-primary-600 flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-gray-700">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Benefits Card -->
      <div class="lg:sticky lg:top-24">
        <div class="p-8 rounded-2xl bg-gradient-to-br from-primary-50 to-accent-50 border border-primary-100">
          <h3 class="text-xl font-bold text-gray-900 mb-6">Key Benefits</h3>
          <div class="space-y-4">
            {benefits.map((benefit, i) => (
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-white text-primary-600 font-bold text-sm flex-shrink-0 shadow-sm">
                  {i + 1}
                </div>
                <span class="text-gray-700 pt-1">{benefit}</span>
              </div>
            ))}
          </div>
          <a
            href="/contact"
            class="mt-8 block text-center px-6 py-3 rounded-lg bg-primary-600 text-white font-semibold hover:bg-primary-700 transition-colors"
          >
            Get a Quote
          </a>
        </div>
      </div>

    </div>

    {/* Process Section */}
    {process && process.length > 0 && (
      <div class="mt-20">
        <h3 class="text-2xl font-bold text-gray-900 text-center mb-12">Our Process</h3>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {process.map((step, i) => (
            <div class="relative p-6 rounded-2xl border border-gray-100 bg-gray-50/50 hover:shadow-lg hover:border-primary-100 transition-all duration-300">
              <div class="w-10 h-10 flex items-center justify-center rounded-xl bg-primary-600 text-white font-bold text-lg mb-4">
                {i + 1}
              </div>
              <h4 class="text-lg font-semibold text-gray-900">{step.title}</h4>
              <p class="mt-2 text-gray-600 text-sm leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>
</section>